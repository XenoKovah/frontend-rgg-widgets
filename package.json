{
  "name": "@rgg-plugins/frontend-rgg-widgets",
  "version": "1.1.0",
  "description": "The Gamma widgets for Open edX",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.raccoongang.com/foss/rgg/frontend-rgg-widgets.git"
  },
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "scripts": {
    "build": "make build",
    "i18n_extract": "fedx-scripts formatjs extract",
    "stylelint": "stylelint \"plugins/**/*.scss\" \"src/**/*.scss\" \"scss/**/*.scss\" --config .stylelintrc.json",
    "lint": "npm run stylelint && fedx-scripts eslint --ext .js --ext .jsx --no-eslintrc --config .eslintrc.js .",
    "lint:fix": "npm run stylelint -- --fix && fedx-scripts eslint --ext .js --ext .jsx --no-eslintrc --config .eslintrc.js . --fix",
    "snapshot": "fedx-scripts jest --updateSnapshot",
    "start": "fedx-scripts webpack-dev-server --progress",
    "start:with-theme": "paragon install-theme && npm start && npm install",
    "test": "fedx-scripts jest --coverage --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "author": "Raccoon Gang",
  "license": "AGPL-3.0",
  "homepage": "https://gitlab.raccoongang.com/foss/rgg/frontend-rgg-widgets/-/blob/main/CHANGELOG.md",
  "publishConfig": {
    "@rgg-plugins:registry": "https://gitlab.raccoongang.com/api/v4/projects/3495/packages/npm/"
  },
  "files": [
    "/dist"
  ],
  "bugs": {
    "url": "https://gitlab.raccoongang.com/foss/rgg/frontend-rgg-widgets/-/issues"
  },
  "dependencies": {
    "@edx/brand": "npm:@openedx/brand-openedx@^1.2.2",
    "@edx/frontend-platform": "^8.3.0",
    "@edx/openedx-atlas": "^0.7.0",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-regular-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/react-fontawesome": "0.2.6",
    "@openedx/paragon": "^23.18.0",
    "@tanstack/react-query": "4.36.1",
    "classnames": "^2.5.1",
    "core-js": "3.45.1",
    "prop-types": "^15.8.1",
    "react-router": "6.30.1",
    "react-router-dom": "6.30.1",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.1.1",
    "@edx/stylelint-config-edx": "^2.3.3",
    "@openedx/frontend-build": "^14.6.2",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.5.2",
    "husky": "7.0.4",
    "jest": "30.2.0",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "peerDependencies": {
    "@edx/frontend-platform": "^7.0.0 || ^8.0.0",
    "@openedx/paragon": ">= 22.0.0 < 24.0.0",
    "prop-types": "^15.5.10",
    "react": "^16.9.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.9.0 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.14.2"
  }
}
